% =========================================================
% websites.bib — Online Sources
% =========================================================
%
% This file contains all internet-based references used in the thesis.
%
% Typical sources include:
% - official documentation (frameworks, APIs)
% - research blogs and technical articles
% - tutorials and educational web pages
% - online reports and whitepapers
%
% Included BibTeX types:
%
% @online         → Web pages, blogs, documentation, digital articles
%
% =========================================================
@online{authorsyeartitle,
  author    = {Author, A. and Author, B.},
  title     = {Title of the Web Page or Article},
  year      = {XXXX},
  url       = {https://www.example.com},
  note      = {Additional notes about the source (e.g., access date [Accessed: YYYY-MM-DD], relevance)},
  keywords  = {web}
}